MEDIA_ROOT=/media/files
ENV=local

# add gcp variables in order to use GCP storage
GCP_BLOB_STORAGE_BUCKET_NAME=
GCP_BLOB_STORAGE_AUTH_KEY=
#GCP_BLOB_USE_EMULATOR=false
#STORAGE_EMULATOR_HOST=
MEDIA_EXPIRES=60

# add azure variables in order to use Azure storage
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# add AWS variables in order to use S3 storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

SENTRY_ENABLED=false
SENTRY_TRACE_ENABLED=false
SENTRY_DSN=

# Auth
AUTH_ENABLED=false
AUTH_VERIFY_SSL=false
API_KEY=123

# Postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=file_storage
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# Possible values: none, user, organisation
ACCESS_MODE=none
ADMINS_GROUP=deps-admins

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps
RABBITMQ_DLX_PER_QUEUE=false

# Kafka
KAFKA_GROUP_ID=file-storage

# Feature flags:
FEATURE_ASYNC_FILE_STORAGE=false

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-file-storage
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
